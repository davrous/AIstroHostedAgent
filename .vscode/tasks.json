{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AIstro: verifier les ports",
      "type": "aitk",
      "command": "debug-check-prerequisites",
      "args": { "portOccupancy": [5679, 8088] }
    },
    {
      "label": "AIstro: demarrer l'agent",
      "type": "shell",
      "command": "\"${workspaceFolder}/.venv/bin/python\" -m debugpy --listen 127.0.0.1:5679 main.py",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["AIstro: verifier les ports"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": "^.*$", "file": 0, "location": 1, "message": 2 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|[Rr]unning on"
        }
      }
    },
    {
      "label": "AIstro: ouvrir Agent Inspector",
      "type": "shell",
      "command": "echo '${input:openAgentInspector}'",
      "dependsOn": ["AIstro: demarrer l'agent"],
      "presentation": { "reveal": "never" }
    }
  ],
  "inputs": [
    {
      "id": "openAgentInspector",
      "type": "command",
      "command": "ai-mlstudio.openTestTool",
      "args": { "triggeredFrom": "tasks", "port": 8088 }
    }
  ]
}
